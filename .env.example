# Gemini AI API Key - Get from https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq AI API Key (Backup LLM - Fast Inference) - Get from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Flask Secret Key - Change this to a random string in production
SECRET_KEY=your_secret_key_here

# Application Settings
FLASK_ENV=development
FLASK_DEBUG=True

# Redis Caching (Optional - system works without it)
# Local Redis: redis://localhost:6379/0
# Upstash (Free tier): redis://default:your_password@your_instance.upstash.io:6379
# Redis Cloud: redis://default:your_password@your_instance.redis-cloud.com:6379
REDIS_URL=redis://localhost:6379/0

# Enable/disable caching (true/false)
CACHE_ENABLED=true